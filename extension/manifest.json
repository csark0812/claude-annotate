{
  "manifest_version": 3,
  "name": "Claude Annotate",
  "version": "0.8.5",
  "description": "Annotate any page in Chrome. Notes and marks go to your Claude Code session.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude Annotate: click to annotate this page",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "commands": {
    "toggle-annotate": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Annotate this tab, holding what the pointer hovers"
    },
    "toggle-record": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Record this tab while you use it (again to stop)"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus",
    "webNavigation",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
