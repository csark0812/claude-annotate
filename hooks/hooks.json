{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ticker.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_annotate_annotate__annotate_(open|done)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/deliver.mjs"
            ],
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "Annotations arrived from the page",
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/deliver.mjs"
            ],
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "Annotations arrived from the page",
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/prompted.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./pane.tsx"
  ]
}
